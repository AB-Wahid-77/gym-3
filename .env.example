# ============================================================================
# IRONFORGE - Environment Variables Configuration
# Server-side environment variables loaded by server.ts via dotenv.
# None of these are prefixed with VITE_ so they are never exposed to the client.
# ============================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Service Role Key (secret key that bypasses RLS on backend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gemini API Key: Required for Gemini 3.8 Flash workout & diet plan generation
GEMINI_API_KEY="your-gemini-api-key"

# Super Admin Secret: Long random secret required to provision new gym workspaces via /provision-new-gym
SUPER_ADMIN_SECRET="your-super-admin-secret-key-here"

# Application hosting URL (optional / dev default)
APP_URL="http://localhost:3000"

# Frontend URL: In split deployments (e.g. frontend on Vercel, backend on Bonto),
# set this to the deployed frontend's URL (e.g. "https://your-app.vercel.app")
# to restrict CORS origin properly in production instead of allowing wildcard '*'.
FRONTEND_URL="http://localhost:3000"
